DEVELOPMENT_TEAM = 
PRODUCT_BUNDLE_IDENTIFIER = org.jellyfin.swiftfin

// Discover seed list (tvOS): titles you love from outside the app, as starting ratings.
// Comma-separated tv:<tmdbId> or movie:<tmdbId>, optionally weighted: *2 loved, *1 liked (default),
// *0 neutral, *-1 disliked, e.g. tv:1399*2,movie:27205. No "//" (it starts a comment here).
// Set it in the git-ignored DevelopmentTeam.xcconfig.
DISCOVER_SEED_TITLES =

// glassfin-helper (tvOS): the Mac service for Coming This Week (Sonarr's calendar) and Ask Glassfin.
// GLASSFIN_HELPER_URL is host:port without "http://" (xcconfig treats "//" as a comment); the app adds the scheme.
// Set both in the git-ignored DevelopmentTeam.xcconfig.
GLASSFIN_HELPER_URL =
GLASSFIN_HELPER_TOKEN =

#include? "DevelopmentTeam.xcconfig"
